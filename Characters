import type { GameEngine } from './GameEngine';
import type { TurnManager } from './TurnManager';
import type { Logger } from '../services/Logger';

/**
 * Game — top-level coordinator.
 *
 * Delegates to GameEngine (state + events) and TurnManager (ordering).
 * No role or effect logic lives here.
 */
export class Game {
  constructor(
    private readonly engine: GameEngine,
    private readonly turnManager: TurnManager,
    private readonly logger: Logger,
  ) {}

  async runRound(): Promise<void> {
    this.turnManager.startRound();
    const players = this.engine.getAllPlayers();

    for (const player of players) {
      await this.turnManager.processTurn(player);
    }

    this.logger.info(`Round ${this.engine.round} complete.`);
  }
}

