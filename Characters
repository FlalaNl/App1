import { GameEventType, type TurnStartedPayload, type TurnEndedPayload, type RoundStartedPayload } from './GameEvents';
import type { GameEngine } from './GameEngine';
import type { Player } from './Player';

/**
 * TurnManager — pure orchestration, no game logic.
 * Drives the turn loop and emits lifecycle events.
 *
 * Extensibility hooks:
 *   - [COOLDOWN] Check and decrement cooldowns before TURN_STARTED
 *   - [STATUS_EFFECT] Apply per-turn status effect ticks here
 *   - [AI_BOT] Insert bot decision logic in processTurn
 */
export class TurnManager {
  constructor(private readonly engine: GameEngine) {}

  startRound(): void {
    this.engine.incrementRound();
    this.engine.emit<RoundStartedPayload>(GameEventType.ROUND_STARTED, {
      round: this.engine.round,
    });
  }

  async processTurn(player: Player): Promise<void> {
    if (player.isSkipped) {
      player.setSkipped(false);
      this.engine.logger.info(`${player.name} is skipped this turn.`);
      return;
    }

    const payload: TurnStartedPayload = {
      playerId: player.id,
      round: this.engine.round,
      turnIndex: this.engine.turnIndex,
    };

    this.engine.emit<TurnStartedPayload>(GameEventType.TURN_STARTED, payload);

    // [AI_BOT] — if player is a bot, inject automated decision here

    this.engine.incrementTurn();

    const endPayload: TurnEndedPayload = {
      playerId: player.id,
      round: this.engine.round,
      turnIndex: this.engine.turnIndex,
    };

    this.engine.emit<TurnEndedPayload>(GameEventType.TURN_ENDED, endPayload);
  }
}

