import { BaseRole, type RoleContext } from './BaseRole';
import type { Effect } from '../effects/Effect';
import type { GameEvent } from '../core/GameEvents';
import { GameEventType } from '../core/GameEvents';
import { DrinkEffect } from '../effects/DrinkEffect';
import { RemoveDrinkEffect } from '../effects/DrinkEffect';

/**
 * Tank — absorbs punishment for others.
 * Passive: Can absorb 1 drink per round meant for an ally.
 * PowerUp: Give 2 drinks to a target, remove 1 from self.
 * PowerDown: Takes 3 drinks (over-extension).
 */
export class Tank extends BaseRole {
  readonly name = 'Tank';
  readonly description = 'Built different. Drinks for the team, punishes enemies.';

  private hasAbsorbedThisRound = false;

  onEvent(event: GameEvent<unknown>, context: RoleContext): void {
    if (event.type === GameEventType.ROUND_STARTED) {
      this.hasAbsorbedThisRound = false;
    }

    if (event.type === GameEventType.DRINK_ASSIGNED && !this.hasAbsorbedThisRound) {
      const payload = event.payload as { toPlayerId: string };
      // If another player is being targeted, Tank can absorb
      if (payload.toPlayerId !== context.player.id && context.random.next() < 0.3) {
        this.hasAbsorbedThisRound = true;
        context.logger.info(`[Tank] ${context.player.name} takes the hit for ${payload.toPlayerId}!`);
        context.engine.resolveEffects(
          [new DrinkEffect(context.player.id, 1, 'Tank Absorption')],
          { sourcePlayer: context.player, engine: context.engine, logger: context.logger },
        );
      }
    }
  }

  usePowerUp(context: RoleContext): Effect[] {
    const targets = context.allPlayers.filter(p => p.id !== context.player.id);
    if (targets.length === 0) return [];
    const target = context.random.pick(targets);
    context.logger.info(`[Tank] ${context.player.name} strikes ${target.name} and recovers!`);
    return [
      new DrinkEffect(target.id, 2, 'Tank Strike'),
      new RemoveDrinkEffect(context.player.id, 1),
    ];
  }

  triggerPowerDown(context: RoleContext): Effect[] {
    context.logger.info(`[Tank] Over-extended — taking heavy damage!`);
    return [new DrinkEffect(context.player.id, 3, 'Tank Overextension')];
  }
}

