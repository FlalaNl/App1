import { BaseRole, type RoleContext } from './BaseRole';
import type { Effect, EffectContext } from '../effects/Effect';
import type { GameEngine } from '../core/GameEngine';
import type { Player } from '../core/Player';
import type { GameRuleModifier } from '../core/GameEngine';
import { DrinkEffect } from '../effects/DrinkEffect';
import { EffectType } from '../effects/Effect';

const BARTENDER_MODIFIER_ID = 'bartender-house-rule';

/**
 * Bartender — installs global rule modifiers.
 *
 * Passive: Registers a house rule on game start: all DRINK effects of 1
 *          are doubled (last call modifier).
 *
 * PowerUp: Swap drink counts between two random players.
 * PowerDown: Remove the house rule and take 2 drinks.
 *
 * Modifier system:
 *   - GameEngine.addRuleModifier installs a transform function
 *   - All effects pass through modifiers before execution
 *   - Multiple modifiers stack and can be removed per-ID
 *
 * [MIDDLEWARE] This is effectively a middleware layer on the effect pipeline.
 * Future modifiers could: add poison effects, change redirect logic, etc.
 */
export class Bartender extends BaseRole {
  readonly name = 'Bartender';
  readonly description = 'Their bar, their rules. House always wins.';

  onRegister(engine: GameEngine, _player: Player): void {
    const modifier: GameRuleModifier = {
      id: BARTENDER_MODIFIER_ID,
      description: 'Last Call: Single drinks are doubled',
      apply(effects: Effect[], _context: EffectContext): Effect[] {
        return effects.map(effect => {
          if (effect.type === EffectType.DRINK) {
            const d = effect as DrinkEffect;
            // Access private fields via serialise for reconstruction
            const s = d.serialize() as { amount: number; targetPlayerId: string; reason: string };
            if (s.amount === 1) {
              engine.logger.info(`[Bartender] Last Call modifier: doubling drink for ${s.targetPlayerId}`);
              return new DrinkEffect(s.targetPlayerId, 2, `${s.reason} [Last Call]`);
            }
          }
          return effect;
        });
      },
    };

    engine.addRuleModifier(modifier);
  }

  usePowerUp(context: RoleContext): Effect[] {
    const players = context.allPlayers;
    if (players.length < 2) return [];
    const shuffled = context.random.shuffle([...players]);
    const a = shuffled[0];
    const b = shuffled[1];
    context.logger.info(`[Bartender] ${context.player.name} swaps ${a.name} ↔ ${b.name}`);
    // SwapEffect is symmetric — one effect handles both sides
    return [new (require('../effects/SwapEffect').SwapEffect)(a.id, b.id)];
  }

  triggerPowerDown(context: RoleContext): Effect[] {
    context.logger.info(`[Bartender] Health inspector arrives — house rules revoked!`);
    context.engine.removeRuleModifier(BARTENDER_MODIFIER_ID);
    return [new DrinkEffect(context.player.id, 2, 'Bartender Shutdown')];
  }
}

