import type { GameEngine } from '../core/GameEngine';
import type { Player } from '../core/Player';
import type { GameEvent } from '../core/GameEvents';
import type { Effect } from '../effects/Effect';
import type { Logger } from '../services/Logger';
import type { RandomProvider } from '../services/RandomProvider';

export interface RoleContext {
  readonly player: Player;
  readonly engine: GameEngine;
  readonly logger: Logger;
  readonly random: RandomProvider;
  readonly allPlayers: Player[];
}

/**
 * BaseRole — contract all roles must satisfy.
 *
 * Lifecycle:
 *   onRegister  → called once when role is bound to player
 *   onEvent     → called on every engine event (passive hook)
 *   usePowerUp  → active ability (player-triggered)
 *   triggerPowerDown → triggered drawback
 *
 * [COOLDOWN] Add cooldownTurns property and check in GameEngine before
 * allowing usePowerUp to be called.
 *
 * [STACKING] Allow multiple roles per player by registering multiple
 * BaseRole instances and chaining onEvent calls.
 */
export abstract class BaseRole {
  abstract readonly name: string;
  abstract readonly description: string;

  onRegister?(engine: GameEngine, player: Player): void;

  onEvent?(event: GameEvent<unknown>, context: RoleContext): void;

  abstract usePowerUp(context: RoleContext): Effect[];

  abstract triggerPowerDown(context: RoleContext): Effect[];
}

