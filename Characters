// ================================
// bootstrap / main.ts  (demonstration)
// ================================

// ─── Service instantiation ──────────────────────────────────────────────────

const logger         = new ConsoleLogger('PourDecisions');
const random         = new SeededRandomProvider(42); // deterministic seed for demo
const effectResolver = new EffectResolver();

// ─── Engine wiring ──────────────────────────────────────────────────────────

const engine = new GameEngine(logger, random, effectResolver);

// ─── Players & Roles ────────────────────────────────────────────────────────

const alice  = new Player('p1', 'Alice');
const bob    = new Player('p2', 'Bob');
const carol  = new Player('p3', 'Carol');
const dave   = new Player('p4', 'Dave');

const aliceRole = new Lawyer();       // Alice will intercept effects
const bobRole   = new Gremlin();      // Bob spreads chaos
const carolRole = new TimeTraveler(); // Carol replays history
const daveRole  = new Bartender();    // Dave sets house rules

engine.registerPlayer(alice, aliceRole);
engine.registerPlayer(bob,   bobRole);
engine.registerPlayer(carol, carolRole);
engine.registerPlayer(dave,  daveRole);

// ─── Wire up TurnManager and Game ───────────────────────────────────────────

const turnManager = new TurnManager(engine);
const game        = new Game(engine, turnManager, logger);

// ─── External event listener (demonstrates typed subscription) ──────────────

engine.on<EffectAppliedPayload>(GameEventType.EFFECT_APPLIED, (event) => {
  logger.debug(`[OBSERVER] Effect applied — type: ${event.payload.effectType}, target: ${event.payload.targetPlayerId}`);
});

engine.on<RoundStartedPayload>(GameEventType.ROUND_STARTED, (event) => {
  logger.info(`\n${'═'.repeat(60)}\n ROUND ${event.payload.round} BEGINS\n${'═'.repeat(60)}`);
});

// ─── Simulation ─────────────────────────────────────────────────────────────

(async () => {
  logger.info('\n🍺 POUR DECISIONS — Game Engine Demo\n');

  // ── Round 1 ──────────────────────────────────────────────────────────────
  await game.runRound();

  // Manual power demonstrations —————————————————————————————————————————————

  logger.info('\n--- Bob (Gremlin) uses PowerUp ---');
  const gremlinContext = engine.makeRoleContext(bob);
  const gremlinEffects = bobRole.usePowerUp(gremlinContext);
  engine.resolveEffects(gremlinEffects, {
    sourcePlayer: bob,
    engine,
    logger,
  });

  logger.info('\n--- Alice (Lawyer) PowerUp — shields an ally ---');
  const lawyerContext = engine.makeRoleContext(alice);
  aliceRole.usePowerUp(lawyerContext); // Registers shield (no effects returned)

  logger.info('\n--- Attempting to assign 1 drink to Alice (should be intercepted) ---');
  const drinkAtAlice = new DrinkEffect(alice.id, 1, 'Test attack on Alice');
  engine.resolveEffects([drinkAtAlice], { sourcePlayer: bob, engine, logger });

  logger.info('\n--- Dave (Bartender) house rule in effect — assigning 1 drink to Bob ---');
  const drinkAtBob = new DrinkEffect(bob.id, 1, 'Regular drink');
  engine.resolveEffects([drinkAtBob], { sourcePlayer: alice, engine, logger });

  // ── Round 2 ──────────────────────────────────────────────────────────────
  await game.runRound();

  logger.info('\n--- Carol (Time Traveler) replays last 3 effects ---');
  const timeTravelerContext = engine.makeRoleContext(carol);
  carolRole.usePowerUp(timeTravelerContext);

  logger.info('\n--- Dave (Bartender) PowerDown — removes house rule ---');
  const bartenderContext = engine.makeRoleContext(dave);
  const bartenderEffects = daveRole.triggerPowerDown(bartenderContext);
  engine.resolveEffects(bartenderEffects, { sourcePlayer: dave, engine, logger });

  // ── Final standings ───────────────────────────────────────────────────────
  logger.info('\n📊 FINAL DRINK COUNTS:');
  for (const player of engine.getAllPlayers()) {
    logger.info(`  ${player.name.padEnd(14)} (${engine.getRole(player.id).name.padEnd(14)}) → ${player.drinkCount} drinks`);
  }

  logger.info('\n📜 EFFECT HISTORY (last 5):');
  const history = effectResolver.effectHistory.slice(-5);
  history.forEach((e, i) => logger.info(`  ${i + 1}. ${e.describe()}`));
})();

Role.usePowerUp() → Effect[] → GameEngine.resolveEffects()
  → applyRuleModifiers() [Bartender layer]
    → EffectResolver.resolve()
      → runInterceptors() [Lawyer layer]
        → effect.execute() [state mutation]
          → emit(EFFECT_APPLIED)

