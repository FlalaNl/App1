import { BaseRole, type RoleContext } from './BaseRole';
import type { Effect } from '../effects/Effect';
import type { GameEngine } from '../core/GameEngine';
import type { Player } from '../core/Player';
import { DrinkEffect } from '../effects/DrinkEffect';
import { EffectType } from '../effects/Effect';

const LAWYER_OBJECTIONS_PER_ROUND = 2;

/**
 * Lawyer — exploits legal loopholes to cancel effects.
 *
 * Passive: Registers an interceptor on the EffectResolver that can cancel
 *          DRINK effects targeting the Lawyer, up to N times per round.
 *          Interceptor is installed on onRegister and persists for game lifetime.
 *
 * PowerUp: Cancel the next drink effect targeting any player (one-time).
 * PowerDown: Loses all objections and takes 2 drinks (disbarment).
 *
 * Interception architecture:
 *   - EffectResolver has an interceptor map keyed by string ID.
 *   - Lawyer registers an interceptor under `lawyer-<playerId>`.
 *   - Each interceptor returns false to cancel the effect.
 */
export class Lawyer extends BaseRole {
  readonly name = 'Lawyer';
  readonly description = 'Legally, they don\'t have to drink. For now.';

  private objections = LAWYER_OBJECTIONS_PER_ROUND;
  private shieldedPlayerId: string | null = null;

  onRegister(engine: GameEngine, player: Player): void {
    // Install persistent interceptor into EffectResolver
    engine['effectResolver'].addInterceptor(`lawyer-${player.id}`, (effect, _context) => {
      // Cancel drinks targeting this player while objections remain
      if (
        effect.type === EffectType.DRINK &&
        effect.targetPlayerId === player.id &&
        this.objections > 0
      ) {
        this.objections--;
        engine.logger.warn(
          `[Lawyer] OBJECTION! Drink blocked for ${player.name}. Objections left: ${this.objections}`,
        );
        return false; // cancel
      }

      // Cancel drinks targeting shielded ally (PowerUp)
      if (
        effect.type === EffectType.DRINK &&
        this.shieldedPlayerId !== null &&
        effect.targetPlayerId === this.shieldedPlayerId
      ) {
        engine.logger.warn(`[Lawyer] Shield triggered for ${this.shieldedPlayerId}`);
        this.shieldedPlayerId = null;
        return false;
      }

      return true; // allow
    });
  }

  usePowerUp(context: RoleContext): Effect[] {
    const targets = context.allPlayers.filter(p => p.id !== context.player.id);
    if (targets.length === 0) return [];
    const ally = context.random.pick(targets);
    this.shieldedPlayerId = ally.id;
    context.logger.info(`[Lawyer] ${context.player.name} extends legal protection to ${ally.name}`);
    return []; // effect handled via interceptor
  }

  triggerPowerDown(context: RoleContext): Effect[] {
    context.logger.info(`[Lawyer] ${context.player.name} DISBARRED — all objections lost!`);
    this.objections = 0;
    this.shieldedPlayerId = null;
    return [new DrinkEffect(context.player.id, 2, 'Lawyer Disbarment')];
  }
}

