import { BaseRole, type RoleContext } from './BaseRole';
import type { Effect } from '../effects/Effect';
import type { GameEvent } from '../core/GameEvents';
import { GameEventType } from '../core/GameEvents';
import { DrinkEffect } from '../effects/DrinkEffect';

/**
 * Social Butterfly — thrives on group dynamics.
 * Passive: When a new round starts, deals 1 drink to the player with the most drinks.
 * PowerUp: All other players drink 1.
 * PowerDown: Drinks 1 for each other player (social debt).
 */
export class SocialButterfly extends BaseRole {
  readonly name = 'Social Butterfly';
  readonly description = 'Life of the party — everyone drinks when she says so.';

  onEvent(event: GameEvent<unknown>, context: RoleContext): void {
    if (event.type === GameEventType.ROUND_STARTED) {
      const mostDrinks = context.allPlayers
        .filter(p => p.id !== context.player.id)
        .sort((a, b) => b.drinkCount - a.drinkCount)[0];

      if (mostDrinks) {
        context.logger.info(`[SocialButterfly] Passive: ${mostDrinks.name} is targeted!`);
        context.engine.resolveEffects(
          [new DrinkEffect(mostDrinks.id, 1, 'Social Butterfly Passive')],
          { sourcePlayer: context.player, engine: context.engine, logger: context.logger },
        );
      }
    }
  }

  usePowerUp(context: RoleContext): Effect[] {
    const others = context.allPlayers.filter(p => p.id !== context.player.id);
    context.logger.info(`[SocialButterfly] Party time — everyone drinks!`);
    return others.map(p => new DrinkEffect(p.id, 1, 'Social Butterfly Toast'));
  }

  triggerPowerDown(context: RoleContext): Effect[] {
    const otherCount = context.allPlayers.filter(p => p.id !== context.player.id).length;
    context.logger.info(`[SocialButterfly] Social debt — drinking for everyone!`);
    return [new DrinkEffect(context.player.id, otherCount, 'Social Butterfly Debt')];
  }
}

