import { BaseRole, type RoleContext } from './BaseRole';
import type { Effect } from '../effects/Effect';
import type { GameEvent } from '../core/GameEvents';
import { GameEventType } from '../core/GameEvents';
import { DrinkEffect } from '../effects/DrinkEffect';
import { ImmunityEffect } from '../effects/ImmunityEffect';

/**
 * Lightweight — low tolerance but quick recovery.
 * Passive: Every 3 drinks received, takes 1 extra (low tolerance).
 * PowerUp: Gains immunity for 1 round.
 * PowerDown: Drinks double the next assigned amount.
 */
export class Lightweight extends BaseRole {
  readonly name = 'Lightweight';
  readonly description = 'Fragile but surprisingly resilient in short bursts.';

  private drinksSinceLastTrigger = 0;
  private static readonly TOLERANCE_THRESHOLD = 3;

  onEvent(event: GameEvent<unknown>, context: RoleContext): void {
    if (event.type === GameEventType.DRINK_TAKEN) {
      const payload = event.payload as { playerId: string; amount: number };
      if (payload.playerId !== context.player.id) return;

      this.drinksSinceLastTrigger += payload.amount;
      if (this.drinksSinceLastTrigger >= Lightweight.TOLERANCE_THRESHOLD) {
        this.drinksSinceLastTrigger = 0;
        context.logger.info(`[Lightweight] Low tolerance triggered — extra drink!`);
        context.engine.resolveEffects(
          [new DrinkEffect(context.player.id, 1, 'Lightweight Tolerance')],
          { sourcePlayer: context.player, engine: context.engine, logger: context.logger },
        );
      }
    }
  }

  usePowerUp(context: RoleContext): Effect[] {
    context.logger.info(`[Lightweight] ${context.player.name} steels themselves — temporary immunity!`);
    return [new ImmunityEffect(context.player.id, true)];
  }

  triggerPowerDown(context: RoleContext): Effect[] {
    context.logger.info(`[Lightweight] Immunity collapses — vulnerability exposed!`);
    return [
      new ImmunityEffect(context.player.id, false),
      new DrinkEffect(context.player.id, 2, 'Lightweight Crash'),
    ];
  }
}

