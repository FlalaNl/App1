import { BaseRole, type RoleContext } from './BaseRole';
import type { Effect } from '../effects/Effect';
import { DrinkEffect } from '../effects/DrinkEffect';

const GREMLIN_DISTRIBUTE_TOTAL = 3;

/**
 * Gremlin — chaotic neutral drink distributor.
 * Passive: None.
 * PowerUp: Randomly distributes 3 drinks across all players (deterministic via RandomProvider).
 * PowerDown: All chaos redirects to themselves.
 *
 * RandomProvider is injected — never calls Math.random() directly.
 * This makes Gremlin's distribution fully testable and replayable.
 */
export class Gremlin extends BaseRole {
  readonly name = 'Gremlin';
  readonly description = 'Pure chaos. No one is safe, not even the Gremlin.';

  usePowerUp(context: RoleContext): Effect[] {
    const effects: Effect[] = [];
    const players = context.allPlayers;
    if (players.length === 0) return [];

    for (let i = 0; i < GREMLIN_DISTRIBUTE_TOTAL; i++) {
      // RandomProvider.pick is deterministic when using SeededRandomProvider
      const target = context.random.pick(players);
      effects.push(new DrinkEffect(target.id, 1, 'Gremlin Chaos'));
    }

    context.logger.info(`[Gremlin] ${context.player.name} unleashes chaos!`);
    return effects;
  }

  triggerPowerDown(context: RoleContext): Effect[] {
    context.logger.info(`[Gremlin] Chaos absorbed — all drinks come home!`);
    return [new DrinkEffect(context.player.id, GREMLIN_DISTRIBUTE_TOTAL, 'Gremlin Self-Chaos')];
  }
}

