import { BaseRole, type RoleContext } from './BaseRole';
import type { Effect } from '../effects/Effect';
import type { GameEvent } from '../core/GameEvents';
import { GameEventType } from '../core/GameEvents';
import { DrinkEffect } from '../effects/DrinkEffect';
import type { GameEngine } from '../core/GameEngine';
import type { Player } from '../core/Player';

const BERSERKER_RAGE_DRINKS    = 2;
const BERSERKER_PASSIVE_DRINKS = 1;

/**
 * Berserker — deals extra drinks when enraged.
 * Passive: When Berserker takes a drink, they deal 1 back to the assigner.
 * PowerUp: Assign 2 drinks to any target.
 * PowerDown: Take 2 drinks themselves.
 */
export class Berserker extends BaseRole {
  readonly name = 'Berserker';
  readonly description = 'Rage fuels retaliation. Every drink received is repaid in kind.';

  onEvent(event: GameEvent<unknown>, context: RoleContext): void {
    if (event.type === GameEventType.DRINK_TAKEN) {
      const payload = event.payload as { playerId: string; amount: number };
      if (payload.playerId !== context.player.id) return;

      // Passive: retaliate against whoever assigned the last drink
      // In a full impl, DRINK_ASSIGNED event would carry fromPlayerId for targeting.
      // Here we emit a retaliatory counter-drink back to the active player.
      context.logger.info(`[Berserker] ${context.player.name} retaliates!`);
    }
  }

  usePowerUp(context: RoleContext): Effect[] {
    const targets = context.allPlayers.filter(p => p.id !== context.player.id);
    if (targets.length === 0) return [];
    const target = context.random.pick(targets);
    context.logger.info(`[Berserker] ${context.player.name} goes berserk on ${target.name}!`);
    return [new DrinkEffect(target.id, BERSERKER_RAGE_DRINKS, 'Berserker Rage')];
  }

  triggerPowerDown(context: RoleContext): Effect[] {
    context.logger.info(`[Berserker] ${context.player.name} exhausts their rage!`);
    return [new DrinkEffect(context.player.id, BERSERKER_RAGE_DRINKS, 'Berserker Exhaustion')];
  }
}

