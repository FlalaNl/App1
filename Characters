import { BaseRole, type RoleContext } from './BaseRole';
import type { Effect } from '../effects/Effect';
import type { GameEngine } from '../core/GameEngine';
import type { Player } from '../core/Player';
import { DrinkEffect } from '../effects/DrinkEffect';

const REPLAY_DEPTH = 3;

/**
 * Time Traveler — manipulates effect history.
 *
 * Passive: None (history tracking is always-on in EffectResolver).
 * PowerUp: Replays the last 3 effects from history (drinking them again).
 * PowerDown: Paradox — takes 3 drinks.
 *
 * The EffectResolver maintains a full effect history.
 * TimeTraveler calls effectResolver.replayLast(N, context, engine).
 *
 * [REPLAY SYSTEM] The history array in EffectResolver can be serialised
 * and replayed for game recordings or debugging.
 */
export class TimeTraveler extends BaseRole {
  readonly name = 'Time Traveler';
  readonly description = 'What happened will happen again. Time is a flat circle.';

  private effectResolverRef: import('../effects/EffectResolver').EffectResolver | null = null;

  onRegister(engine: GameEngine, _player: Player): void {
    // Store reference to resolver for replay — injected via engine
    this.effectResolverRef = engine['effectResolver'];
  }

  usePowerUp(context: RoleContext): Effect[] {
    if (!this.effectResolverRef) return [];
    context.logger.info(`[TimeTraveler] ${context.player.name} rewinds time!`);
    this.effectResolverRef.replayLast(REPLAY_DEPTH, {
      sourcePlayer: context.player,
      engine: context.engine,
      logger: context.logger,
    }, context.engine);
    return [];
  }

  triggerPowerDown(context: RoleContext): Effect[] {
    context.logger.info(`[TimeTraveler] Temporal paradox — reality collapses!`);
    return [new DrinkEffect(context.player.id, 3, 'Temporal Paradox')];
  }
}

