import { BaseRole, type RoleContext } from './BaseRole';
import type { Effect } from '../effects/Effect';
import type { GameEvent } from '../core/GameEvents';
import { GameEventType } from '../core/GameEvents';
import { RemoveDrinkEffect } from '../effects/DrinkEffect';
import { DrinkEffect } from '../effects/DrinkEffect';

const CLERIC_HEAL_AMOUNT   = 2;
const CLERIC_PASSIVE_HEAL  = 1;

/**
 * Cleric — healer and buffer.
 * Passive: At round start, removes 1 drink from the player with the most drinks.
 * PowerUp: Removes 2 drinks from any player.
 * PowerDown: Takes 2 drinks (divine punishment).
 */
export class Cleric extends BaseRole {
  readonly name = 'Cleric';
  readonly description = 'Channel divine mercy. Or suffer divine punishment.';

  onEvent(event: GameEvent<unknown>, context: RoleContext): void {
    if (event.type === GameEventType.ROUND_STARTED) {
      const neediest = context.allPlayers
        .sort((a, b) => b.drinkCount - a.drinkCount)[0];

      if (neediest && neediest.drinkCount > 0) {
        context.logger.info(`[Cleric] Healing ${neediest.name}`);
        context.engine.resolveEffects(
          [new RemoveDrinkEffect(neediest.id, CLERIC_PASSIVE_HEAL)],
          { sourcePlayer: context.player, engine: context.engine, logger: context.logger },
        );
      }
    }
  }

  usePowerUp(context: RoleContext): Effect[] {
    const targets = context.allPlayers.filter(p => p.drinkCount > 0);
    if (targets.length === 0) {
      context.logger.info('[Cleric] No one needs healing.');
      return [];
    }
    const target = targets.sort((a, b) => b.drinkCount - a.drinkCount)[0];
    context.logger.info(`[Cleric] ${context.player.name} heals ${target.name} for ${CLERIC_HEAL_AMOUNT}`);
    return [new RemoveDrinkEffect(target.id, CLERIC_HEAL_AMOUNT)];
  }

  triggerPowerDown(context: RoleContext): Effect[] {
    context.logger.info(`[Cleric] Divine punishment!`);
    return [new DrinkEffect(context.player.id, CLERIC_HEAL_AMOUNT, 'Divine Punishment')];
  }
}

