import { BaseRole, type RoleContext } from './BaseRole';
import type { Effect } from '../effects/Effect';
import type { GameEvent } from '../core/GameEvents';
import { GameEventType } from '../core/GameEvents';
import { RedirectEffect } from '../effects/RedirectEffect';
import { DrinkEffect } from '../effects/DrinkEffect';

/**
 * Trickster — misdirection specialist.
 * Passive: 50% chance to redirect incoming drinks to a random other player.
 * PowerUp: Redirect the last drink assigned to someone else.
 * PowerDown: Takes 2 drinks themselves.
 */
export class Trickster extends BaseRole {
  readonly name = 'Trickster';
  readonly description = 'Nothing is as it seems. Drinks have a way of finding new targets.';

  private lastIncomingDrink: DrinkEffect | null = null;

  onEvent(event: GameEvent<unknown>, context: RoleContext): void {
    if (event.type === GameEventType.DRINK_ASSIGNED) {
      const payload = event.payload as { toPlayerId: string; amount: number; fromPlayerId: string };
      if (payload.toPlayerId !== context.player.id) return;

      // Store for PowerUp reference
      this.lastIncomingDrink = new DrinkEffect(payload.toPlayerId, payload.amount, 'Original assignment');

      // Passive 50% dodge
      if (context.random.next() < 0.5) {
        const others = context.allPlayers.filter(
          p => p.id !== context.player.id && p.id !== payload.fromPlayerId,
        );
        if (others.length === 0) return;
        const redirectTo = context.random.pick(others);
        context.logger.info(`[Trickster] Passive redirect triggered!`);
        const effects = [new RedirectEffect(redirectTo.id, this.lastIncomingDrink, context.player.name)];
        context.engine.resolveEffects(effects, {
          sourcePlayer: context.player,
          engine: context.engine,
          logger: context.logger,
        });
      }
    }
  }

  usePowerUp(context: RoleContext): Effect[] {
    if (!this.lastIncomingDrink) {
      context.logger.warn('[Trickster] No drink to redirect yet.');
      return [];
    }
    const targets = context.allPlayers.filter(p => p.id !== context.player.id);
    if (targets.length === 0) return [];
    const newTarget = context.random.pick(targets);
    return [new RedirectEffect(newTarget.id, this.lastIncomingDrink, context.player.name)];
  }

  triggerPowerDown(context: RoleContext): Effect[] {
    context.logger.info(`[Trickster] The trick backfires!`);
    return [new DrinkEffect(context.player.id, 2, 'Trickster Backfire')];
  }
}

